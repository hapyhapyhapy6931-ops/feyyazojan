{
    "name": "support-ticket-platform/app",
    "type": "project",
    "description": "Production-ready support ticket platform with Laravel 12, Livewire, and FilamentPHP",
    "keywords": ["support", "ticket", "platform", "laravel", "livewire", "filament"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "laravel/breeze": "^2.0",
        "laravel/sanctum": "^4.0",
        "livewire/livewire": "^3.4",
        "filamentphp/filament": "^3.2",
        "spatie/laravel-permission": "^6.4",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-query-builder": "^5.6",
        "spatie/laravel-backup": "^8.5",
        "spatie/laravel-translatable": "^6.5",
        "maatwebsite/excel": "^3.1",
        "intervention/image": "^3.6",
        "league/flysystem-aws-s3-v3": "^3.25",
        "nesbot/carbon": "^3.0",
        "laravel/tinker": "^2.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "laravel/pint": "^1.16",
        "laravel/sail": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "spatie/laravel-test-time": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "12.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
